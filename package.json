{
  "name": "drvasundara-premium-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "node scripts/build-social-images.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs && node scripts/verify-build.mjs && node scripts/verify-approval-boundary.mjs && node scripts/verify-journal.mjs && node scripts/editorial-report.mjs --check && node scripts/verify-search-readiness.mjs && node scripts/verify-host-consistency.mjs",
    "format": "prettier --write .",
    "review:export": "node scripts/export-clinician-review.mjs",
    "journal:report": "node scripts/editorial-report.mjs",
    "journal:validate": "node scripts/editorial-report.mjs --check",
    "journal:new": "node scripts/new-article.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "release:prepare": "node scripts/prepare-production-artifact.mjs",
    "release:verify": "node scripts/verify-production-artifact.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "6.0.3"
  }
}
