---
import { Image } from 'astro:assets';
import type { PublicArticle } from '../../utils/articles';
import { articleReadingTime } from '../../utils/articles';
import { journalCategory, categoryPath } from '../../utils/journal-data';
interface Props {
  entry: PublicArticle;
  number?: number;
}
const { entry, number = 1 } = Astro.props;
const category = journalCategory(entry.data);
---

<article class="journal-card" data-article-slug={entry.data.slug}>
  {entry.data.featuredImage && (
    <a href={`/blog/${entry.data.slug}/`} tabindex="-1" aria-hidden="true">
      <Image
        class="journal-card-image"
        src={entry.data.featuredImage}
        alt=""
        width={640}
        height={420}
        loading="lazy"
      />
    </a>
  )}
  <a class="journal-category-label" href={categoryPath(category!.id)}>
    {category!.name}
  </a>
  <h3>
    <a href={`/blog/${entry.data.slug}/`}>{entry.data.title}</a>
  </h3>
  <p>{entry.data.excerpt}</p>
  <div class="journal-card-meta">
    <span>{articleReadingTime(entry)} min read</span>
    <span>Medical review recorded</span>
  </div>
</article>

<style>
  .journal-card-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 640/420;
    object-fit: cover;
    margin-bottom: 24px;
    border-radius: 10px;
  }
</style>
