---
import { site, navigation } from '../../config/site';
// Bootstrap Icons v1.11.3 (MIT); see public/licenses/bootstrap-icons.txt.
import youtube from '../../assets/social-icons/youtube.svg?raw';
import facebook from '../../assets/social-icons/facebook.svg?raw';
import instagram from '../../assets/social-icons/instagram.svg?raw';
import linkedin from '../../assets/social-icons/linkedin.svg?raw';
const socialIcons: Record<string, string> = {
  YouTube: youtube,
  Facebook: facebook,
  Instagram: instagram,
  LinkedIn: linkedin,
};
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">
        Dr. Vasundara<small class="brand-surname">Cheepurupalli</small>
      </a>
      <p>
        A thoughtful space for
        <br />
        women’s healthcare.
      </p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="/testimonials/">Patient experiences</a>
      {navigation.map((n) => (
        <a href={n.href}>{n.label}</a>
      ))}
    </nav>
    <div class="footer-contact">
      <span class="eyebrow">GET IN TOUCH</span>
      {site.contact.phone && (
        <a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a>
      )}
      {site.contact.email && (
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      )}
      {site.contact.address && <p>{site.contact.address}</p>}
      {site.contact.mapUrl && (
        <a href={site.contact.mapUrl}>Find the clinic ↗</a>
      )}
      {!site.contact.phone && !site.contact.email && (
        <p>
          Verified clinic details will
          <br />
          be available here soon.
        </p>
      )}
      <nav class="footer-socials" aria-label="Social media">
        {site.socials.map((s) => (
          <a
            class="social-link"
            href={s.url}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={`${s.label} (opens in a new tab)`}
            title={s.label}
          >
            <span
              class="social-logo"
              aria-hidden="true"
              set:html={socialIcons[s.label]}
            />
          </a>
        ))}
      </nav>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>
      © {new Date().getFullYear()} {site.name}
    </span>
    <div>
      <a href="/privacy/">Privacy Policy</a>
    </div>
    <span>Care. Clarity. Confidence.</span>
  </div>
  <div class="container">
    <p class="development-credit">
      Thoughtfully Designed &amp; Developed by{' '}
      <a
        href="https://www.sunsolv.in/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="SunSolv Technologies (opens in a new tab)"
      >
        SunSolv Technologies
      </a>
    </p>
  </div>
</footer>

<style>
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .footer-contact .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ink);
  }
  .social-logo {
    display: flex;
  }
  .social-logo :global(svg) {
    width: 20px;
    height: 20px;
  }

  .development-credit {
    margin: 0;
    padding-block: 0.75rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.75;
    text-align: right;
  }
  .development-credit a {
    display: inline-block;
    padding-block: 0.5rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .development-credit a:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .development-credit {
      text-align: center;
    }
  }
</style>
