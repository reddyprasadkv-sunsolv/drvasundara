---
import AppointmentCTA from '../ui/AppointmentCTA.astro';
import Botanical from '../ui/Botanical.astro';
---

<section class="appointment-section">
  <div class="container appointment-inner">
    <div>
      <span class="eyebrow">YOUR NEXT CHAPTER</span>
      <h2>
        Your health questions
        <br />
        <em>deserve attention.</em>
      </h2>
      <p>
        Connect with the clinic on WhatsApp to discuss consultation
        availability.
      </p>
    </div>
    <div class="appointment-action">
      <AppointmentCTA light />
      <p>
        Consultations are subject to clinic confirmation. WhatsApp is not
        monitored for medical emergencies.
      </p>
      <a href="/privacy/">Your privacy matters</a>
    </div>
    <Botanical class="appointment-botanical" />
  </div>
</section>
