---
import { Image } from 'astro:assets';
import doctor from '../../assets/doctor.png';
import { site } from '../../config/site';
import Botanical from '../ui/Botanical.astro';
interface Props {
  small?: boolean;
}
---

<div class:list={['portrait-stage', { 'portrait-small': Astro.props.small }]}>
  <span class="portrait-halo" aria-hidden="true"></span>
  <Botanical class="portrait-botanical" />
  {site.doctor.portraitApproved ? (
    <Image
      src={doctor}
      alt="Dr. Vasundhara"
      widths={[360, 540, 720, 1000]}
      sizes="(max-width: 700px) 88vw, 45vw"
      loading={Astro.props.small ? 'lazy' : 'eager'}
      priority={!Astro.props.small}
      class="doctor-photo"
    />
  ) : (
    <div class="portrait-placeholder">
      <span class="monogram">V</span>
      <p>Dr. Vasundhara</p>
    </div>
  )}
  <span class="portrait-label">
    DR. VASUNDHARA <span>WOMEN’S HEALTHCARE</span>
  </span>
</div>
