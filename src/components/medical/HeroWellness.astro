---
import { Image } from 'astro:assets';
import wellness from '../../assets/hero-clinic.jpg';
---

<figure class="wellness-visual">
  <div class="wellness-image-frame">
    <Image
      src={wellness}
      alt="Illustrative scene of a doctor speaking with a woman in a bright clinic"
      width={800}
      height={1000}
      fit="cover"
      widths={[400, 600, 800]}
      sizes="(max-width: 600px) 88vw, (max-width: 850px) 43vw, 520px"
      priority
      loading="eager"
      class="wellness-photo"
    />
    <span class="wellness-corner" aria-hidden="true"></span>
  </div>
</figure>
