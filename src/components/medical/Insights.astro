---
import { publicArticles, readingTime } from '../../utils/articles';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
const articles = (await publicArticles()).slice(0, 3);
---

{articles.length ? (
  <div class="article-grid">
    {await Promise.all(
      articles.map(async (a) => {
        const author = await getEntry(a.data.author);
        return (
          <article>
            {a.data.featuredImage && (
              <Image
                src={a.data.featuredImage}
                alt={a.data.imageAlt || ''}
                width={640}
                loading="lazy"
              />
            )}
            <span class="eyebrow">{a.data.category}</span>
            <h3>
              <a href={`/blog/${a.data.slug}/`}>{a.data.title}</a>
            </h3>
            <p>{a.data.excerpt}</p>
            <small>
              {author?.data.name} · {readingTime(a.body)} min read
            </small>
            <p>
              <time datetime={a.data.publishedAt.toISOString()}>
                Published {a.data.publishedAt.toLocaleDateString('en-IN')}
              </time>
            </p>
            {a.data.medicalReviewedAt && (
              <small>
                Medically reviewed{' '}
                {a.data.medicalReviewedAt.toLocaleDateString('en-IN')}
              </small>
            )}
          </article>
        );
      }),
    )}
  </div>
) : (
  <div class="insights-empty">
    <div class="editorial-symbol" aria-hidden="true">
      <span>W</span>
      <i>health journal</i>
    </div>
    <div>
      <span class="eyebrow">A LITTLE KNOWLEDGE. MORE CONFIDENCE.</span>
      <h3>
        A considered perspective
        <br />
        on women’s health.
      </h3>
      <p>
        Doctor-authored, medically reviewed insights are on their way. Every
        article will be reviewed before it appears here.
      </p>
      <span class="coming-soon">THE JOURNAL · COMING SOON</span>
    </div>
  </div>
)}
