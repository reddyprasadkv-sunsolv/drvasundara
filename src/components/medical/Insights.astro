---
import { publicArticles, readingTime } from '../../utils/articles';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import menstrual from '../../assets/insights/menstrual-health.svg';
import antenatal from '../../assets/insights/antenatal-care.svg';
import contraception from '../../assets/insights/contraception.svg';
const illustrations = {
  'abnormal-uterine-bleeding': {
    image: menstrual,
    alt: 'Calendar and a drop illustrating menstrual bleeding',
  },
  'antenatal-visit-questions': {
    image: antenatal,
    alt: 'Appointment checklist with a heart illustrating preparation for antenatal visits',
  },
  'contraception-choices': {
    image: contraception,
    alt: 'Contraceptive pill pack and a shield illustrating contraceptive choices',
  },
};
interface Props {
  limit?: number;
}
const { limit = 3 } = Astro.props;
const articles = (await publicArticles()).slice(0, limit);
---

{articles.length ? (
  <div class="article-grid">
    {await Promise.all(
      articles.map(async (a) => {
        const author = await getEntry(a.data.author);
        const illustration =
          illustrations[a.data.slug as keyof typeof illustrations];
        return (
          <article>
            {illustration ? (
              <Image
                src={illustration.image}
                alt={illustration.alt}
                width={640}
                height={420}
                loading="lazy"
              />
            ) : (
              a.data.featuredImage && (
                <Image
                  src={a.data.featuredImage}
                  alt={a.data.imageAlt || ''}
                  width={640}
                  loading="lazy"
                />
              )
            )}
            <span class="eyebrow">{a.data.category}</span>
            <h3>
              <a href={`/blog/${a.data.slug}/`}>{a.data.title}</a>
            </h3>
            <p>{a.data.excerpt}</p>
            <small>
              {author?.data.name} · {readingTime(a.body)} min read
            </small>
            <p>
              <time datetime={a.data.publishedAt.toISOString()}>
                Published {a.data.publishedAt.toLocaleDateString('en-IN')}
              </time>
            </p>
            {a.data.medicalReviewedAt && (
              <small>
                Medically reviewed{' '}
                {a.data.medicalReviewedAt.toLocaleDateString('en-IN')}
              </small>
            )}
          </article>
        );
      }),
    )}
  </div>
) : (
  <div class="insights-empty">
    <div class="editorial-symbol" aria-hidden="true">
      <span>W</span>
      <i>health journal</i>
    </div>
    <div>
      <span class="eyebrow">A LITTLE KNOWLEDGE. MORE CONFIDENCE.</span>
      <h3>
        A considered perspective
        <br />
        on women’s health.
      </h3>
      <p>
        Educational articles are being prepared. Authorship and genuine medical
        review will be clearly identified when approved articles are published.
      </p>
      <span class="coming-soon">THE JOURNAL · COMING SOON</span>
    </div>
  </div>
)}
