---
import { approvedServices } from '../../data/services';
import { publicArticles } from '../../utils/articles';
import { expertVideos } from '../../data/expert-videos';
import { publishedTestimonials } from '../../data/testimonials';
interface Props {
  featured?: boolean;
  expert?: boolean;
}
const articles = Astro.props.expert ? await publicArticles() : [];
const videos = Astro.props.expert
  ? expertVideos
  : Astro.props.featured
    ? publishedTestimonials.filter((v) => v.featured)
    : publishedTestimonials;
---

{videos.length > 0 && (
  <>
    <div class="patient-videos">
      {videos.map((video, index) => (
        <article
          class="patient-video"
          data-video-kind={
            Astro.props.expert ? 'educational' : 'patient-experience'
          }
        >
          <div
            class="video-stage"
            data-video-id={video.id}
            data-video-title={video.title}
          >
            <a
              class="video-preview"
              href={`https://www.youtube.com/watch?v=${video.id}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="video-number" aria-hidden="true">
                0{index + 1}
              </span>
              <svg
                class="video-play"
                viewBox="0 0 64 64"
                fill="none"
                aria-hidden="true"
              >
                <circle cx="32" cy="32" r="30" stroke="currentColor" />
                <path d="M27 22L43 32L27 42Z" fill="currentColor" />
              </svg>
              <span>
                Watch {video.title}
                <span class="sr-only"> on YouTube (opens a new tab)</span>
              </span>
            </a>
          </div>
          <span class="eyebrow">{video.topic}</span>
          <h3>{video.title}</h3>
          <a
            class="text-link"
            href={`https://www.youtube.com/watch?v=${video.id}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch on YouTube ↗<span class="sr-only"> (opens a new tab)</span>
          </a>
          {Astro.props.expert && 'relatedServices' in video && (
            <nav
              class="expert-related"
              aria-label={`Related reading for ${video.title}`}
            >
              {approvedServices
                .filter((s) => video.relatedServices.includes(s.slug))
                .map((s) => (
                  <a href={`/services/${s.slug}/`}>{s.name}</a>
                ))}
              {articles
                .filter((a) => video.relatedArticles.includes(a.data.slug))
                .map((a) => (
                  <a href={`/blog/${a.data.slug}/`}>{a.data.title}</a>
                ))}
            </nav>
          )}
        </article>
      ))}
    </div>
    <p class="patient-note">
      {Astro.props.expert
        ? 'Watch educational videos linked from the clinic’s original website.'
        : 'These videos share individual patient experiences. Experiences and outcomes vary; they do not predict the care or outcome of another person.'}{' '}
      Playing a video connects to YouTube.{' '}
      <a href="/privacy/">Privacy information</a>.
    </p>
  </>
)}
{!Astro.props.expert && videos.length === 0 && (
  <p>Patient experience videos are currently unavailable.</p>
)}
<script>
  document.querySelectorAll<HTMLDivElement>('.video-stage').forEach((stage) => {
    const link = stage.querySelector<HTMLAnchorElement>('.video-preview');
    if (!link) return;
    link.target = '_self';
    const hidden = link.querySelector('.sr-only');
    if (hidden) hidden.textContent = ' (loads a YouTube player)';
    link.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
        return;
      event.preventDefault();
      const id = stage.dataset.videoId;
      if (!id || !/^[A-Za-z0-9_-]{11}$/.test(id)) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}`;
      frame.title = stage.dataset.videoTitle || 'Clinic video';
      frame.loading = 'lazy';
      frame.allow = 'encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      stage.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .expert-related {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 18px;
    font-size: 13px;
  }
  .expert-related a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
