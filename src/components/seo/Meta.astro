---
import { site } from '../../config/site';
import { canonicalUrl, publicAssetUrl } from '../../utils/urls';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  article?: boolean;
  image?: string;
  imageAlt?: string;
}
const {
  title,
  description = site.description,
  noindex = false,
  article = false,
  image,
  imageAlt,
} = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
const socialImage =
  image || publicAssetUrl('/images/social-preview.png', Astro.site || site.url);
---

<title>{title} | {site.name}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={
    !site.productionIndexing || noindex ? 'noindex, nofollow' : 'index, follow'
  }
/>
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={socialImage} />
<meta
  property="og:image:alt"
  content={
    imageAlt ||
    'Dr. Vasundara Cheepurupalli — Thoughtful care for every stage of womanhood'
  }
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

{!image && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
