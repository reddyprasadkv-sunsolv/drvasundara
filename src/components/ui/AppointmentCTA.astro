---
import { safeWhatsAppUrl } from '../../utils/editorial.mjs';
import { site } from '../../config/site';
interface Props {
  label?: string;
  light?: boolean;
}
const { label = 'Talk to Us', light = false } = Astro.props;
const url = safeWhatsAppUrl(site.whatsappUrl) || '/appointment/';
---

<a
  class:list={['button', { 'button-light': light }]}
  href={url}
  data-contact-channel="whatsapp"
  target="_blank"
  rel="noopener noreferrer"
>
  {label}
  <span aria-hidden="true">↗</span>
  <span class="sr-only"> (opens WhatsApp in a new tab)</span>
</a>
