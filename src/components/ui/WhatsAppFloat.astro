---
import { site } from '../../config/site';
---

<a
  class="whatsapp-float"
  href={site.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with the clinic on WhatsApp (opens a new tab)"
>
  <svg
    viewBox="0 0 32 32"
    width="26"
    height="26"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M26 15a11 11 0 0 1-16 10L4 27l2-6a11 11 0 1 1 20-6Z"
      stroke="currentColor"
      stroke-width="2"
    />
    <path d="M11 10c-3 4 5 12 9 9l-3-3-2 1-2-2 1-2-3-3Z" fill="currentColor" />
  </svg>
  <span>WhatsApp</span>
</a>
<style>
  .whatsapp-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 30;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 14px 18px;
    border-radius: 40px;
    background: #146c43;
    color: white;
    box-shadow: 0 5px 22px #352c462b;
    font-size: 14px;
    font-weight: 600;
  }
  .whatsapp-float:hover {
    background: #105835;
  }
  .whatsapp-float:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .whatsapp-float {
      right: 16px;
      bottom: 16px;
      padding: 14px;
    }
    .whatsapp-float span {
      display: none;
    }
  }
  @media print {
    .whatsapp-float {
      display: none;
    }
  }
</style>
