---
import { safeFormUrl } from '../utils/editorial.mjs';
import { site } from '../config/site';
import Page from '../layouts/Page.astro';
import AppointmentCTA from '../components/ui/AppointmentCTA.astro';
const available = safeFormUrl(site.appointmentFormUrl);
---

<Page
  title="Begin with a conversation"
  eyebrow="CONNECT WITH THE CLINIC"
  description="Contact the clinic on WhatsApp to discuss consultation availability."
>
  <div class="prose">
    <h2>Chat with the clinic on WhatsApp.</h2>
    <p>
      Message the clinic to ask about consultation availability and
      arrangements. The clinic will confirm your appointment.
    </p>
    <AppointmentCTA />
    {available && <AppointmentCTA useForm label="Open appointment form" />}
    <p>
      Share only the information needed to arrange a consultation. Avoid sending
      detailed medical histories, reports or sensitive health information in an
      initial message.
    </p>
    <p>
      WhatsApp opens in a new tab and its privacy terms apply.{' '}
      <a href="/privacy/">Read our privacy information.</a>
    </p>
    <p class="notice">WhatsApp is not monitored for medical emergencies.</p>
  </div>
</Page>
