---
import { render, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { publicArticles, readingTime } from '../../utils/articles';
import { site } from '../../config/site';
export async function getStaticPaths() {
  return (await publicArticles()).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const author = await getEntry(entry.data.author);
const reviewer = entry.data.reviewer
  ? await getEntry(entry.data.reviewer)
  : undefined;
const related = (await publicArticles()).filter((a) =>
  entry.data.relatedArticles.includes(a.data.slug),
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.excerpt,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt || entry.data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: author?.data.name },
  reviewedBy: { '@type': 'Person', name: reviewer?.data.name },
  lastReviewed: entry.data.medicalReviewedAt?.toISOString(),
  mainEntityOfPage: new URL(Astro.url.pathname, site.url).href,
  ...(entry.data.featuredImage
    ? { image: new URL(entry.data.featuredImage.src, site.url).href }
    : {}),
};
---

<Base
  title={entry.data.seo.title || entry.data.title}
  description={entry.data.seo.description || entry.data.excerpt}
  schema={schema}
>
  <article class="container article-page">
    <Breadcrumbs label={entry.data.title} />
    <span class="eyebrow">{entry.data.category}</span>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.excerpt}</p>
    <p>
      By {author?.data.name} · {readingTime(entry.body)} min read
    </p>
    <p>
      Published{' '}
      <time datetime={entry.data.publishedAt.toISOString()}>
        {entry.data.publishedAt.toLocaleDateString('en-IN')}
      </time>
      {entry.data.updatedAt && (
        <>
          {' '}
          · Updated{' '}
          <time datetime={entry.data.updatedAt.toISOString()}>
            {entry.data.updatedAt.toLocaleDateString('en-IN')}
          </time>
        </>
      )}
    </p>
    <p>
      Medically reviewed by {reviewer?.data.name} on{' '}
      {entry.data.medicalReviewedAt?.toLocaleDateString('en-IN')}
    </p>
    {entry.data.featuredImage && (
      <Image
        src={entry.data.featuredImage}
        alt={entry.data.imageAlt || ''}
        width={1100}
      />
    )}
    <div class="prose">
      <Content />
    </div>
    <h2>Sources & references</h2>
    <ol>
      {entry.data.sources.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            {s.title}
            <span class="sr-only"> (new tab)</span>
          </a>
        </li>
      ))}
    </ol>
    {related.length > 0 && (
      <aside>
        <h2>Related insights</h2>
        {related.map((a) => (
          <p>
            <a href={`/blog/${a.data.slug}/`}>{a.data.title}</a>
          </p>
        ))}
      </aside>
    )}
    <p class="notice">
      General information cannot replace individual medical advice.{' '}
      <a href="/medical-disclaimer/">Read our medical disclaimer.</a>
    </p>
  </article>
</Base>
