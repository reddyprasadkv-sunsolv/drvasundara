---
import { render, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { publicArticles, articleReadingTime } from '../../utils/articles';
import { journalCategory, categoryPath } from '../../utils/journal-data';
import { curatedArticles } from '../../utils/journal.mjs';
import { site } from '../../config/site';
import AppointmentCTA from '../../components/ui/AppointmentCTA.astro';
import { approvedServices } from '../../data/services';
import { articleSchema, breadcrumbSchema } from '../../utils/schema';
import { publicAssetUrl } from '../../utils/urls';
import ArticleCollection from '../../components/journal/ArticleCollection.astro';
import EditorialByline from '../../components/journal/EditorialByline.astro';
import ReadingTools from '../../components/journal/ReadingTools.astro';
import MedicalFAQs from '../../components/medical/MedicalFAQs.astro';
import { articleKnowledge } from '../../utils/faqs';
export async function getStaticPaths() {
  return (await publicArticles()).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const author = (await getEntry(entry.data.author))!;
const reviewer = (await getEntry(entry.data.reviewer))!;
const category = journalCategory(entry.data)!;
const related = curatedArticles(entry, await publicArticles());
const services = approvedServices.filter((s) =>
  entry.data.relatedServices.includes(s.slug),
);
const primary = approvedServices.find(
  (s) => s.slug === entry.data.relatedServices[0],
);
const safetyNotice = [
  'ectopic-pregnancy-warning-signs',
  'high-risk-pregnancy',
  'abnormal-uterine-bleeding',
].includes(entry.data.slug)
  ? primary?.whenToSeek
  : undefined;
const socialImage = entry.data.featuredImage
  ? publicAssetUrl(
      `/images/journal/${entry.data.slug}.png`,
      Astro.site || site.url,
    )
  : undefined;
const schema = articleSchema(
  entry.data,
  Astro.url.pathname,
  author.data.name,
  reviewer.data.name,
  socialImage,
  author.data.entityType,
  {
    author:
      author.data.entityType === 'Organization'
        ? site.url
        : author.data.profileUrl,
    reviewer:
      reviewer.id === 'dr-vasundara'
        ? site.url + '/blog/authors/dr-vasundara/'
        : reviewer.data.profileUrl,
    section: category.name,
  },
);
schema['@graph'].push(
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Journal', path: '/blog/' },
    { name: category.name, path: categoryPath(category.id) },
    { name: entry.data.title, path: Astro.url.pathname },
  ]) as never,
);
const showToc =
  articleReadingTime(entry) >= 2 &&
  headings.filter((h) => h.depth === 2).length >= 4;
---

<Base
  title={entry.data.seo.title || entry.data.title}
  description={entry.data.seo.description || entry.data.excerpt}
  schema={schema}
  article
  image={socialImage}
  imageAlt={entry.data.imageAlt}
>
  <article class="container journal-reading-page">
    <Breadcrumbs
      label={entry.data.title}
      items={[
        { label: 'Home', href: '/' },
        { label: 'Journal', href: '/blog/' },
        { label: category.name, href: categoryPath(category.id) },
      ]}
    />
    <header class="journal-article-header">
      <a class="eyebrow" href={categoryPath(category.id)}>
        {category.name}
      </a>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.excerpt}</p>
      {safetyNotice && (
        <aside class="journal-safety-notice" aria-label="When to seek care">
          <span class="eyebrow">WHEN TO SEEK CARE</span>
          <p>{safetyNotice}</p>
        </aside>
      )}
      <EditorialByline entry={entry} />
      <ReadingTools headings={headings} showToc={showToc} />
    </header>
    {entry.data.featuredImage && (
      <figure class="journal-article-cover">
        <Image
          src={entry.data.featuredImage}
          alt={entry.data.imageAlt || ''}
          width={1100}
          widths={[440, 760, 1100]}
          sizes="(max-width: 767px) 92vw, 80vw"
          loading="lazy"
        />
        {entry.data.imageCredit && (
          <figcaption>{entry.data.imageCredit}</figcaption>
        )}
      </figure>
    )}
    <div class:list={['journal-reading-layout', { 'has-toc': showToc }]}>
      {showToc && (
        <nav class="article-toc-desktop" aria-label="On this page">
          <span class="eyebrow">ON THIS PAGE</span>
          {headings
            .filter((h) => h.depth === 2 || h.depth === 3)
            .map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          <a href="#article-questions">Questions</a>
          <a href="#article-references">References</a>
        </nav>
      )}
      <div class="journal-article-content">
        <section class="article-takeaways" aria-labelledby="takeaway-title">
          <span class="eyebrow" id="takeaway-title">
            KEY TAKEAWAYS
          </span>
          <ul>
            {entry.data.keyTakeaways.map((t) => {
              const question = entry.data.medicalFaqs.find(
                (f) => f.answer === t,
              )?.question;
              return (
                <li>
                  {question && <strong>{question} </strong>}
                  {t}
                </li>
              );
            })}
          </ul>
        </section>
        <p class="article-introduction">{entry.data.introduction}</p>
        <div class="prose reading-prose">
          <Content />
        </div>
        <section id="article-questions" class="article-faqs">
          <span class="eyebrow">QUESTIONS, WITH CONTEXT</span>
          <h2>What you may be wondering.</h2>
          <MedicalFAQs items={articleKnowledge(entry)} />
        </section>
        <section id="article-references" class="article-reference-section">
          <span class="eyebrow">SUPPORTING READING</span>
          <h2>Sources and references.</h2>
          <ol>
            {entry.data.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.title}
                  <span class="sr-only"> (opens a new tab)</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="journal-reference-note">
            References provide context for this educational overview. Your
            clinician can explain how guidance applies to your circumstances.
          </p>
        </section>
        <section class="article-services">
          <h2>Related care information.</h2>
          <nav aria-label="Related services">
            {services.map((s) => (
              <a href={`/services/${s.slug}/`}>
                {s.name}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </section>
        <section class="article-appointment">
          <span class="eyebrow">A CONVERSATION ABOUT YOU</span>
          <h2>Your questions deserve attention.</h2>
          <AppointmentCTA />
        </section>
        <p class="notice article-disclaimer">{entry.data.clinicalDisclaimer}</p>
        <p class="journal-policy-note">
          <a href="/blog/editorial-policy/">
            Our editorial and medical review approach
          </a>
        </p>
      </div>
    </div>
    {related.length > 0 && (
      <section class="journal-related-articles">
        <span class="eyebrow">READ NEXT</span>
        <h2>Another perspective.</h2>
        <ArticleCollection articles={related} />
      </section>
    )}
  </article>
</Base>
