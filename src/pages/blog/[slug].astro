---
import { render, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { publicArticles, readingTime } from '../../utils/articles';
import { site } from '../../config/site';
import AppointmentCTA from '../../components/ui/AppointmentCTA.astro';
import { approvedServices } from '../../data/services';
import { articleSchema } from '../../utils/schema';
import { publicAssetUrl } from '../../utils/urls';
export async function getStaticPaths() {
  return (await publicArticles()).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const author = await getEntry(entry.data.author);
const reviewer = entry.data.reviewer
  ? await getEntry(entry.data.reviewer)
  : undefined;
const related = (await publicArticles()).filter((a) =>
  entry.data.relatedArticles.includes(a.data.slug),
);
const socialImage = entry.data.featuredImage
  ? publicAssetUrl(entry.data.featuredImage.src, Astro.site || site.url)
  : undefined;
const schema = articleSchema(
  entry.data,
  Astro.url.pathname,
  author!.data.name,
  reviewer!.data.name,
  socialImage,
  author!.data.entityType,
);
const relatedServices = approvedServices.filter((s) =>
  entry.data.relatedServices.includes(s.slug),
);
---

<Base
  title={entry.data.seo.title || entry.data.title}
  description={entry.data.seo.description || entry.data.excerpt}
  schema={schema}
  article
  image={socialImage}
>
  <article class="container article-page">
    <Breadcrumbs label={entry.data.title} />
    <span class="eyebrow">{entry.data.category}</span>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.excerpt}</p>
    {entry.data.authorship === 'ai-assisted' && (
      <p class="authorship-disclosure">
        Prepared with AI assistance; clinically reviewed as identified below.
      </p>
    )}
    <p>
      By {author?.data.name} · {readingTime(entry.body)} min read
    </p>
    <p>
      Published{' '}
      <time datetime={entry.data.publishedAt.toISOString()}>
        {entry.data.publishedAt.toLocaleDateString('en-IN')}
      </time>
      {entry.data.updatedAt && (
        <>
          {' '}
          · Updated{' '}
          <time datetime={entry.data.updatedAt.toISOString()}>
            {entry.data.updatedAt.toLocaleDateString('en-IN')}
          </time>
        </>
      )}
    </p>
    <p>
      Medically reviewed by {reviewer?.data.name} on{' '}
      {entry.data.medicalReviewedAt?.toLocaleDateString('en-IN')}
      {reviewer?.data.medicalRegistration && (
        <span>
          {' '}
          · {reviewer.data.medicalRegistration.authority}:{' '}
          {reviewer.data.medicalRegistration.number}
        </span>
      )}
    </p>
    {entry.data.featuredImage && (
      <Image
        src={entry.data.featuredImage}
        alt={entry.data.imageAlt || ''}
        width={1100}
      />
    )}
    <div class="article-takeaways">
      <span class="eyebrow">KEY TAKEAWAYS</span>
      <ul>
        {entry.data.keyTakeaways.map((takeaway) => (
          <li>{takeaway}</li>
        ))}
      </ul>
    </div>
    <p class="article-introduction">{entry.data.introduction}</p>
    <div class="prose">
      <Content />
    </div>
    {entry.data.medicalFaqs.length > 0 && (
      <section class="article-faqs">
        <h2>Questions, with context.</h2>
        <div class="faq-list">
          {entry.data.medicalFaqs
            .filter((f) => f.reviewed)
            .map((f) => (
              <details>
                <summary>
                  {f.question}
                  <span aria-hidden="true">+</span>
                </summary>
                <p>{f.answer}</p>
              </details>
            ))}
        </div>
      </section>
    )}
    <h2>Sources & references</h2>
    <ol>
      {entry.data.sources.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            {s.title}
            <span class="sr-only"> (new tab)</span>
          </a>
        </li>
      ))}
    </ol>
    {related.length > 0 && (
      <aside>
        <h2>Related insights</h2>
        {related.map((a) => (
          <p>
            <a href={`/blog/${a.data.slug}/`}>{a.data.title}</a>
          </p>
        ))}
      </aside>
    )}
    {relatedServices.length > 0 && (
      <aside>
        <h2>Related care information.</h2>
        {relatedServices.map((service) => (
          <p>
            <a href={`/services/${service.slug}/`}>{service.name}</a>
          </p>
        ))}
      </aside>
    )}
    <section class="article-appointment">
      <h2>A conversation about your concerns.</h2>
      <AppointmentCTA />
    </section>
    <p class="notice">
      This article provides general educational information and cannot replace
      individual medical advice. Seek professional assessment for your
      circumstances. Appointment requests are not intended for emergencies.
    </p>
  </article>
</Base>
