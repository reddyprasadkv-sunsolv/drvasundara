---
import Page from '../layouts/Page.astro';
import { site } from '../config/site';
import { publicPractice } from '../config/local-seo';
import { clinicSchema } from '../utils/schema';
---

<Page
  title="Get in touch"
  eyebrow="CONTACT THE PRACTICE"
  description={
    publicPractice
      ? `Find approved contact and appointment information for ${site.name} in ${publicPractice.city}.`
      : 'Find verified clinic contact information and appointment request guidance.'
  }
  schema={
    publicPractice
      ? clinicSchema({ name: publicPractice.practiceName, ...publicPractice })
      : undefined
  }
>
  <div class="prose">
    <h2>Connect with the clinic.</h2>
    {site.contact.phone && (
      <p>
        <a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a>
      </p>
    )}
    {site.contact.email && (
      <p>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
    )}
    {site.contact.address && <address>{site.contact.address}</address>}
    {site.contact.mapUrl && (
      <p>
        <a href={site.contact.mapUrl}>View clinic location</a>
      </p>
    )}
    {!site.contact.phone && !site.contact.email && !site.contact.address && (
      <p>
        Clinic contact details and location are awaiting verification. They will
        be added here once approved.
      </p>
    )}
    <a class="text-link" href="/appointment/">
      Appointment information ↗
    </a>
  </div>
</Page>
