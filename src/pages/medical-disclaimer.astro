---
import Page from '../layouts/Page.astro';
---

<Page
  title="Medical disclaimer"
  eyebrow="INFORMATION WITH CONTEXT"
  description="Website information is general and cannot replace a consultation with a qualified healthcare professional."
>
  <div class="prose">
    <p>
      Content on this website is for general information. It is not a diagnosis,
      a treatment recommendation or a substitute for individual medical advice.
    </p>
    <p>
      Doctor-authored articles will be published only after medical review and
      approval. Consult a qualified healthcare professional about your
      circumstances and decisions.
    </p>
    <p>
      Appointment requests require clinic confirmation. This website and
      appointment request forms are not emergency services.
    </p>
  </div>
</Page>
