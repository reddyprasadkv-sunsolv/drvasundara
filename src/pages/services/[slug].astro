---
import { site } from '../../config/site';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ServiceEditorial from '../../components/medical/ServiceEditorial.astro';
import { approvedServices } from '../../data/services';
import { medicalPageSchema, breadcrumbSchema } from '../../utils/schema';
export function getStaticPaths() {
  return approvedServices.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services/' },
      { name: service.name, path: Astro.url.pathname },
    ]),
    medicalPageSchema({
      title: service.name,
      description: service.description,
      path: Astro.url.pathname,
      reviewer: service.medicalReviewedBy!,
      reviewedAt: service.medicalReviewedAt!,
      sources: service.sources,
    }),
  ],
};
---

<Base
  title={`${service.seo.title || service.name} in Secunderabad`}
  description={`${service.name}: reviewed information and consultation enquiries at ${site.contact.address}. Ask about availability on WhatsApp.`}
  schema={schema}
>
  <div class="container">
    <Breadcrumbs
      label={service.name}
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
      ]}
    />
  </div>
  <ServiceEditorial service={service} />
</Base>
